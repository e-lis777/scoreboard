{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "legion-scoreboard",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".cf-dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/control/*"]
  }
}
